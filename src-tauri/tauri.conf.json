{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DF Harmonica",
  "version": "0.1.0",
  "identifier": "com.dilemmagx.df-harmonica",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/df-harmonica/",
    "beforeDevCommand": "node scripts/ensure-dist.js && npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "DF Harmonica",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}